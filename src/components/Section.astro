---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  class?: string;
}
const { id, eyebrow, title, lede, class: className = '' } = Astro.props;
---

<section id={id} class={`scroll-mt-20 border-t border-border py-20 md:py-28 ${className}`}>
  <div class="container-sc">
    <div class="max-w-2xl" data-reveal>
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h2 class="text-3xl font-medium tracking-[-0.02em] text-balance text-primary md:text-4xl">
        {title}
      </h2>
      {lede && <p class="mt-4 text-base text-secondary md:text-lg">{lede}</p>}
    </div>
    <div class="mt-12" data-reveal style="--reveal-delay: 120ms">
      <slot />
    </div>
  </div>
</section>
