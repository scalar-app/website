---
import { github, withBase } from '../lib/links';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Product',
    links: [
      { label: 'Overview', href: '/#product' },
      { label: 'Integrations', href: '/integrations' },
      { label: 'Download', href: '/download' },
      { label: 'Docs', href: '/docs' },
    ],
  },
  {
    heading: 'Project',
    links: [
      { label: 'GitHub', href: github.org },
      { label: 'Discussions', href: github.discussions },
      { label: 'Contributing', href: github.contributing },
      { label: 'Roadmap', href: github.roadmap },
    ],
  },
  {
    heading: 'Trust',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Security', href: '/security' },
      { label: 'Security policy', href: github.security },
      { label: 'License (AGPL-3.0)', href: 'https://www.gnu.org/licenses/agpl-3.0.html' },
    ],
  },
];
---

<footer class="mt-24 border-t border-border">
  <div class="container-sc grid gap-10 py-12 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="max-w-xs">
      <p class="text-[15px] font-semibold tracking-tight">Scalar</p>
      <p class="mt-2 text-sm text-secondary">
        An open-source operating system for attention. Email, calendar, courses, tasks and files in
        one action layer.
      </p>
    </div>
    {
      columns.map((col) => (
        <nav aria-label={col.heading}>
          <h2 class="eyebrow">{col.heading}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {col.links.map((l) => (
              <li>
                <a href={withBase(l.href)} class="text-secondary no-underline hover:text-primary">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div
    class="container-sc flex flex-wrap items-center justify-between gap-2 border-t border-border py-5 text-xs text-muted"
  >
    <p>Copyright {year} Scalar contributors. Source available under AGPL-3.0.</p>
    <p class="font-mono">scalar-app.github.io</p>
  </div>
</footer>
