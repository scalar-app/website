---
import Page from '../layouts/Page.astro';
import { github } from '../lib/links';

const sections = [
  {
    title: 'Overview',
    href: `${github.docs}#readme`,
    body: 'What Scalar is, the product model (Today, Spaces, tasks, events) and the roadmap.',
  },
  {
    title: 'Self-hosting',
    href: `${github.docs}/tree/main/self-hosting`,
    body: 'Running the API and web app on your own machine or server.',
  },
  {
    title: 'Architecture',
    href: `${github.docs}/tree/main/architecture`,
    body: 'Repositories, data model, API contract and how integrations plug in.',
  },
  {
    title: 'API reference',
    href: `${github.docs}/tree/main/api`,
    body: 'Endpoints under /api/v1, auth, pagination and error format.',
  },
  {
    title: 'Contributing',
    href: github.contributing,
    body: 'Toolchain, conventions, commit format and the review process.',
  },
  {
    title: 'Security',
    href: github.security,
    body: 'Reporting vulnerabilities and what to expect from us.',
  },
];
---

<Page
  title="Docs"
  description="Scalar documentation lives in the scalar-app/docs repository on GitHub."
  path="/docs"
  eyebrow="Documentation"
  lede="Documentation is written in Markdown and lives in a public repository so it can be reviewed and versioned like code."
>
  <ul
    class="not-prose mt-10 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2"
    style="list-style:none;padding:0"
  >
    {
      sections.map((s) => (
        <li class="bg-surface" style="margin:0">
          <a
            href={s.href}
            class="block h-full p-6 no-underline hover:bg-raised"
            rel="noopener"
            style="text-decoration:none"
          >
            <span class="block text-sm font-medium text-primary">{s.title}</span>
            <span class="mt-2 block text-sm text-secondary">{s.body}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-8 text-sm text-muted">
    Some sections may not exist yet. If a link 404s, the page has not been written; open a
    discussion or a PR against <a href={github.docs}>scalar-app/docs</a>.
  </p>
</Page>
