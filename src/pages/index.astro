---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TodayMock from '../components/TodayMock.astro';
import { github, withBase } from '../lib/links';
import { phases, statusLabel } from '../lib/integrations';

const steps = [
  {
    n: '01',
    title: 'Connect',
    body: 'Link the accounts that already hold your obligations: mail, calendar, your school’s LMS. Scalar reads only what it needs and you can disconnect any source at any time.',
  },
  {
    n: '02',
    title: 'Understand',
    body: 'Messages, events and assignments are normalised into one model of tasks, events and Spaces. Effort is estimated, deadlines are ranked, and what needs you today is separated from what can wait.',
  },
  {
    n: '03',
    title: 'Act',
    body: 'One screen shows the plan. Accept it, adjust it, or act directly: reply, schedule, submit, archive. Actions go back to the source system so nothing lives only in Scalar.',
  },
];

const community = [
  { label: 'Discussions', href: github.discussions, body: 'Questions, ideas and show-and-tell.' },
  {
    label: 'Contributing',
    href: github.contributing,
    body: 'How to set up a repo, coding conventions, review process.',
  },
  { label: 'Roadmap', href: github.roadmap, body: 'Public project board with phases and status.' },
  {
    label: 'Security policy',
    href: github.security,
    body: 'How to report a vulnerability privately.',
  },
];
---

<Base
  title="Scalar"
  description="Scalar is an open-source operating system for attention. It connects email, calendar, courses, tasks and files into one action layer."
  path="/"
>
  <section class="container-sc pt-24 pb-20 md:pt-36 md:pb-28">
    <p class="eyebrow mb-6">Open source · AGPL-3.0 · in development</p>
    <h1
      class="max-w-3xl text-4xl font-medium tracking-tight text-primary md:text-6xl md:leading-[1.05]"
    >
      Everything demanding your attention.
      <span class="block text-secondary">One system for handling it.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg text-secondary">
      Scalar connects your email, calendar, courses, tasks and files, then turns them into a single
      plan you can act on.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href={withBase('/download')} class="btn btn-primary">Get started</a>
      <a href={github.org} class="btn" rel="noopener">GitHub</a>
    </div>
  </section>

  <Section
    id="product"
    eyebrow="Product"
    title="Start the day with one screen."
    lede="Today shows what is urgent, what is coming, and a plan Scalar drafted for the hours in between. It is the first thing you see and, on most days, the only thing you need."
  >
    <TodayMock />
    <p class="mt-4 max-w-2xl text-xs text-muted">
      Illustration of the intended Today screen. Data is invented. The web app is in development.
    </p>
  </Section>

  <Section id="how" eyebrow="How Scalar works" title="Connect. Understand. Act.">
    <ol
      class="grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-3"
    >
      {
        steps.map((s) => (
          <li class="bg-surface p-6 md:p-8">
            <p class="font-mono text-xs text-yellow">{s.n}</p>
            <h3 class="mt-3 text-lg font-medium text-primary">{s.title}</h3>
            <p class="mt-2 text-sm text-secondary">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    id="integrations"
    eyebrow="Integrations"
    title="Your systems, in phases."
    lede="None of these ship yet. Statuses below are updated as work lands. Full detail per integration is on the integrations page."
  >
    <div class="grid gap-8 md:grid-cols-3">
      {
        phases.map((p) => (
          <div>
            <h3 class="flex items-baseline gap-3 text-sm font-medium text-primary">{p.label}</h3>
            <ul class="mt-3 divide-y divide-border border-y border-border">
              {p.integrations.map((i) => (
                <li class="flex items-center justify-between gap-3 py-2 text-sm">
                  <span class="text-secondary">{i.name}</span>
                  <span class="tag" data-status={i.status}>
                    {statusLabel[i.status]}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-sm">
      <a
        href={withBase('/integrations')}
        class="text-primary underline decoration-border underline-offset-4 hover:decoration-yellow"
      >
        What each integration will sync
      </a>
    </p>
  </Section>

  <Section
    id="students"
    eyebrow="Student mode"
    title="Built with students first."
    lede="Canvas courses become Spaces. Assignments get an estimated effort and are scheduled as blocks around your classes. Study time is planned, not guessed."
  >
    <ul
      class="grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-3"
    >
      <li class="bg-surface p-6">
        <h3 class="text-sm font-medium text-primary">Courses as Spaces</h3>
        <p class="mt-2 text-sm text-secondary">
          Each course gets its own Space with assignments, files, announcements and notes.
        </p>
      </li>
      <li class="bg-surface p-6">
        <h3 class="text-sm font-medium text-primary">Effort estimates</h3>
        <p class="mt-2 text-sm text-secondary">
          Assignments are sized from their description and your history so plans stay realistic.
        </p>
      </li>
      <li class="bg-surface p-6">
        <h3 class="text-sm font-medium text-primary">Scheduled blocks</h3>
        <p class="mt-2 text-sm text-secondary">
          Work is placed on your calendar as focus blocks you can accept, move or reject.
        </p>
      </li>
    </ul>
    <p class="mt-4 text-xs text-muted">
      Status: planned. Depends on the Canvas LMS integration (Phase 1).
    </p>
  </Section>

  <Section
    id="open-source"
    eyebrow="Open source"
    title="Yours to run, read and change."
    lede="Scalar is licensed under AGPL-3.0. Every part of the stack is public, and the whole thing can be self-hosted."
  >
    <div class="grid gap-10 md:grid-cols-[1fr_1.2fr]">
      <ul class="space-y-3 text-sm text-secondary">
        <li>
          <strong class="font-medium text-primary">Self-hostable.</strong> Run the API and web app on
          your own infrastructure.
        </li>
        <li>
          <strong class="font-medium text-primary">Telemetry can be fully disabled</strong> in self-hosted
          builds.
        </li>
        <li>
          <strong class="font-medium text-primary"
            >No private content is used for model training</strong
          > by default.
        </li>
        <li>
          <strong class="font-medium text-primary">Copyleft.</strong> Improvements to hosted versions
          must be shared back.
        </li>
      </ul>
      <ul class="divide-y divide-border border-y border-border text-sm">
        {
          github.repos.map((r) => (
            <li class="flex items-center justify-between gap-4 py-2.5">
              <a
                href={r.url}
                class="font-mono text-primary no-underline hover:text-yellow"
                rel="noopener"
              >
                scalar-app/{r.name}
              </a>
              <span class="text-right text-secondary">{r.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section
    id="download"
    eyebrow="Download"
    title="Where things stand."
    lede="The web app is in development. Desktop and mobile apps are planned after the web app is usable day to day."
  >
    <div class="flex flex-wrap gap-3">
      <a href={withBase('/download')} class="btn btn-primary">Download page</a>
      <a href={github.releases} class="btn" rel="noopener">GitHub releases</a>
    </div>
  </Section>

  <Section id="community" eyebrow="Community" title="Follow along or help build it.">
    <ul
      class="grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 md:grid-cols-4"
    >
      {
        community.map((c) => (
          <li class="bg-surface">
            <a href={c.href} class="block h-full p-6 no-underline hover:bg-raised" rel="noopener">
              <span class="block text-sm font-medium text-primary">{c.label}</span>
              <span class="mt-2 block text-sm text-secondary">{c.body}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>
